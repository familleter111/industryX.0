# Copier en .env.local (dev) ou déclarer dans Azure App Service (prod).

# Adresse publique du site : canonical, hreflang, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.industryx0.pro

# PostHog (projet EU Cloud). Vide = aucune mesure, aucun bandeau de consentement.
# Utiliser une clé de projet distincte pour la preview et le dev.
NEXT_PUBLIC_POSTHOG_KEY=
# Facultatif : uniquement pour un projet hors région UE.
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# POSTHOG_INGEST_HOST=https://us.i.posthog.com
# POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

# Fichier des demandes de démo (défaut : data/contacts.xlsx).
# CONTACT_XLSX_PATH=

# ------------------------------------------------------------------
# Leads du formulaire de contact — voir docs/leads-integration.md
# Le tableur (CONTACT_XLSX_PATH) reste toujours alimenté ; CRM et
# webhook s'ajoutent, ensemble ou séparément.
# ------------------------------------------------------------------

# CRM actif : hubspot | brevo | pipedrive | none (vide = none).
CRM_PROVIDER=none

# HubSpot — jeton d'application privée (Paramètres > Intégrations > Applications privées).
# Portées : crm.objects.contacts.read/write, crm.objects.deals.read/write.
# + crm.schemas.contacts.write et crm.schemas.deals.write le temps de `npm run leads:check -- setup-hubspot`.
HUBSPOT_ACCESS_TOKEN=
# Pipeline des affaires (« default » = pipeline par défaut du compte).
HUBSPOT_PIPELINE_ID=default
# Identifiant interne de l'étape « Qualification » (obligatoire avec HubSpot).
HUBSPOT_DEAL_STAGE_ID=

# Brevo — clé API (Paramètres > SMTP & API > Clés API).
BREVO_API_KEY=
# Liste où ranger les leads (facultatif, nombre).
BREVO_LIST_ID=
# Pipeline et étape « Qualification » du module Ventes. Vides = contact seulement, sans affaire.
BREVO_PIPELINE_ID=
BREVO_DEAL_STAGE_ID=

# Pipedrive — jeton API personnel (Préférences personnelles > API).
PIPEDRIVE_API_TOKEN=
# Sous-domaine du compte : « industryx0 » pour https://industryx0.pipedrive.com.
PIPEDRIVE_COMPANY_DOMAIN=
# Pipeline des affaires (nombre, obligatoire avec Pipedrive).
PIPEDRIVE_PIPELINE_ID=
# Étape « Qualification » (nombre). Vide = première étape du pipeline.
PIPEDRIVE_STAGE_ID=
# Clé API (40 caractères) du champ d'affaire personnalisé « Industrie ». Vide = champ non rempli.
PIPEDRIVE_INDUSTRY_FIELD_KEY=

# Webhook d'automatisation (n8n, Make, Zapier). Vide = aucun webhook.
LEAD_WEBHOOK_URL=
# Secret partagé de la signature HMAC SHA-256 (en-tête X-Signature). Obligatoire si l'URL est renseignée.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_WEBHOOK_SECRET=

# Email de secours quand une destination échoue, envoyé via Resend (https://resend.com).
# Plusieurs destinataires : séparés par des virgules.
LEAD_FALLBACK_EMAIL=
# Expéditeur sur un domaine vérifié dans Resend, ex. « Leads Industry X.0 <leads@industryx0.pro> ».
LEAD_FALLBACK_FROM=
RESEND_API_KEY=

# ------------------------------------------------------------------
# Assistant de chat IA — voir docs/chatbot.md
# Par défaut, le chat répond en local (mots-clés, rien ne quitte le
# navigateur). Les trois variables ci-dessous activent l'IA.
# ------------------------------------------------------------------

# Widget : "on" envoie les questions à /api/chat (lu au build, change aussi
# les mentions de la politique de confidentialité et des CGU).
NEXT_PUBLIC_CHAT_AI=
# Serveur : "azure" ou "anthropic" autorise la route /api/chat. Vide = route désactivée (404).
CHAT_PROVIDER=
# Azure OpenAI (CHAT_PROVIDER=azure) : https://<ressource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Nom du déploiement créé dans Azure AI Foundry.
AZURE_OPENAI_DEPLOYMENT=
# Modèle à raisonnement seulement (gpt-5, o4-mini…) : low.
# AZURE_OPENAI_REASONING_EFFORT=
# Clé API Anthropic (console.anthropic.com > API Keys). Jamais exposée au navigateur.
ANTHROPIC_API_KEY=
# Modèle Claude (défaut : claude-haiku-5-5, le moins cher, suffisant pour des questions simples).
# CHAT_MODEL=
# Plafond de questions envoyées à l'IA par jour, tous visiteurs confondus (défaut : 50).
# Au-delà, le chat répond sans IA jusqu'au lendemain. 0 = IA coupée.
CHAT_DAILY_LIMIT=50
# Clé de signature des réponses de l'IA (anti-injection, voir docs/chatbot.md).
# Facultative : dérivée de la clé du fournisseur si vide.
# CHAT_SIGNING_SECRET=
